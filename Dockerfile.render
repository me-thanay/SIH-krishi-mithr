# FastAPI + plant diagnosis (YOLO + EfficientNetV2-S) for Render.
# Needs >= 2 GB RAM (Standard plan). Free/Starter 512 MB will OOM when models load.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libglib2.0-0 \
    libgl1 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# CPU-only torch keeps the image smaller; Render has no GPU on standard web services.
COPY requirements.txt requirements.render.txt ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.render.txt

COPY app/ ./app/
RUN mkdir -p ml/models ml/tools
COPY ml/__init__.py ml/
COPY ml/*.py ml/
COPY ml/ip102_classes.json ml/
COPY ml/tools/ ml/tools/
COPY ml/models/plantdoc_efficientnet_v2_s.pt \
     ml/models/maize_efficientnet_v2_s.pt \
     ml/models/leaf_pest_yolo.pt \
     ml/models/ip102_yolo.pt \
     ml/models/plantdoc_labels.json \
     ml/models/maize_labels.json \
     ml/models/plantdoc_metrics.json \
     ml/models/maize_metrics.json \
     ml/models/ip102_yolo_metrics.json \
     ml/models/
COPY ml/models/xgboost/ ml/models/xgboost/

ENV PYTHONPATH=/app
ENV INFERENCE_DEVICE=cpu
ENV OMP_NUM_THREADS=1
ENV MKL_NUM_THREADS=1
ENV TORCH_NUM_THREADS=1
ENV PIP_REQUIRE_HASHES=0
EXPOSE 8000

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
